# Cloudflare Worker host the browser connects to over WebSocket
# (partysocket, apps/web/lib/room-socket.ts). No protocol/scheme prefix.
#
# `wrangler dev` default (local development):
NEXT_PUBLIC_WORKER_HOST=localhost:8787

# Production: Plan 11 fills in the deployed *.workers.dev host here
# (e.g. games-worker.your-subdomain.workers.dev).
