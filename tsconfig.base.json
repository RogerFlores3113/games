{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@games/schema/games/forehead-card": ["packages/schema/src/games/forehead-card.ts"],
      "@games/schema": ["packages/schema/src/index.ts"],
      "@games/rules": ["packages/rules/src/index.ts"]
    }
  }
}
